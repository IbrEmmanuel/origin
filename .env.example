# Origin Electric Webapp — Vite env (baked in at build time)
# Copy to `.env` for local development. NEVER commit `.env`.

# ── Site ──────────────────────────────────────────────
VITE_SITE_URL=https://www.originelectricltd.com

# ── API (browser-safe) ────────────────────────────────
# Same-origin path via Vite/Vercel proxy (recommended for local + Vercel)
VITE_API_URL=/api
# Absolute API origin for media/uploads (no trailing /api)
VITE_API_BASE_URL=https://api.originelectricltd.com

# ── Paystack (public key only — secret key belongs on the API server) ──
# https://dashboard.paystack.com/#/settings/developer
# pk_test_… for test; pk_live_… for production. Redeploy after changing.
VITE_PAYSTACK_PUBLIC_KEY=pk_test_your_key_here

# ── Sales AgentOS ─────────────────────────────────────
VITE_SALES_AGENT_URL=https://staging-ai-agent.fly.dev
VITE_SALES_AGENT_ID=sales-agent
VITE_BOSS_WHATSAPP=2348000000000

# ── Optional Google Maps (checkout map) ───────────────
# VITE_GOOGLE_MAPS_API_KEY=

# ── Optional Firebase overrides (web config is public; restrict in Console) ──
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_MEASUREMENT_ID=

# ── Server-only (DO NOT put these in VITE_* or this frontend repo) ──
# PAYSTACK_SECRET_KEY=sk_...
# DATABASE_URL=...
# JWT_SECRET=...
# SMTP_PASSWORD=...

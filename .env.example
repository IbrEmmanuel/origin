# Origin Electric Webapp — Vite env (baked in at build time)
# Local AgentOS: http://localhost:7777
# Fly staging AgentOS:
VITE_SALES_AGENT_URL=https://staging-ai-agent.fly.dev
VITE_SALES_AGENT_ID=sales-agent
VITE_BOSS_WHATSAPP=2348000000000

# Same-origin API via Vite/Vercel proxy (avoids browser CORS failures)
VITE_API_URL=/api
VITE_API_BASE_URL=

# Paystack — use pk_test_… until live keys are configured
VITE_PAYSTACK_PUBLIC_KEY=pk_test_your_key_here

# Optional
# VITE_GOOGLE_MAPS_API_KEY=
